# Database Configuration
# For local development with local MongoDB
DATABASE_URL="mongodb://localhost:27017/mistica_autentica"

# For Railway MongoDB deployment (example format)
# DATABASE_URL="mongodb://username:password@host:port/database_name?retryWrites=true&w=majority&authSource=admin"

# For Railway MongoDB with connection options
# DATABASE_URL="mongodb://username:password@nozomi.proxy.rlwy.net:23351/mistica_autentica?retryWrites=true&w=majority&authSource=admin&connectTimeoutMS=30000&socketTimeoutMS=30000"

# JWT Configuration
JWT_SECRET="tu_jwt_secret_super_seguro_aqui"
JWT_EXPIRES_IN="24h"

# Application Configuration
NODE_ENV="development"
PORT=3000

# Swagger Configuration
SWAGGER_ENABLED="true"

# Database Connection Options (optional)
# DB_CONNECT_TIMEOUT_MS=30000
# DB_SOCKET_TIMEOUT_MS=30000
# DB_MAX_POOL_SIZE=10
# DB_MIN_POOL_SIZE=1

# Example values for development:
# DATABASE_URL="mongodb://localhost:27017/mistica_autentica"
# JWT_SECRET="dev_secret_key_change_in_production"
# JWT_EXPIRES_IN="24h"
# NODE_ENV="development"
# PORT=3000
# SWAGGER_ENABLED="true"

# Example values for Railway production:
# DATABASE_URL="mongodb://username:password@nozomi.proxy.rlwy.net:23351/mistica_autentica?retryWrites=true&w=majority&authSource=admin"
# JWT_SECRET="production_secret_key_here"
# JWT_EXPIRES_IN="24h"
# NODE_ENV="production"
# PORT=3000
# SWAGGER_ENABLED="false" 
# ── Horarios y mesas del salón ──
# Ventana de reservas del día (hora local): ninguna reserva empieza antes de
# BUSINESS_OPEN ni termina después de BUSINESS_CLOSE. El horario de inicio es
# LIBRE dentro de la ventana.
# BUSINESS_OPEN="15:00"
# BUSINESS_CLOSE="20:00"
# Turnos SUGERIDOS del día (hora local). Formato KEY|Nombre|HH:mm|HH:mm
# separados por ";". No restringen: ordenan la oferta de la landing y el bot.
# SHIFTS="T1|Turno 1|15:00|17:30;T2|Turno 2|17:50|20:00"
# Minutos de limpieza después de CADA reserva: la mesa queda tomada hasta
# fin + este buffer.
# CLEANING_BUFFER_MINUTES=10
# ¿Un grupo de hasta 6 puede quedarse con una mesa grande entera cuando no hay
# mesas de 2 ni compartida posible? Por defecto no (se rechaza la reserva).
# SMALL_GROUP_CAN_TAKE_LARGE="false"

# ── Pago de la seña: SOLO transferencia con comprobante ──
# MercadoPago quedó fuera del flujo del cliente (el módulo sigue en el repo pero
# no se crean preferences nuevas). Estos datos los muestra la landing al reservar
# y el bot por WhatsApp: deben coincidir con los del bot.
# TRANSFER_ALIAS="mistica.arte"
# TRANSFER_OWNER_NAME="Nombre del titular"
# TRANSFER_BANK="Banco"
# WhatsApp al que el cliente manda el comprobante (internacional, sin +).
# BUSINESS_WHATSAPP="5491122334455"
